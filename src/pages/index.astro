---
import WelcomeComponent from '../components/welcome/index.vue'
import Info from '../components/info/index.vue'
import GalleryComponent from '../components/gallery/index.vue'
import GiftTable from '../components/giftTable/index.vue'
import MainPhoto from '../components/mainPhoto/index.vue'
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<WelcomeComponent class="bg-pearl"/>
	<div class="bg-pearl shadow-4xl pb-20">
		<MainPhoto class="mx-5" />
	</div>
	<div class="bg-pearl shadow-4xl">
		<Info />
	</div>
	<div class="bg-salmon-pink pb-14 px-5">
		<GiftTable />
	</div>
	<div >
		<GalleryComponent client:visible />
	</div>
</Layout>
